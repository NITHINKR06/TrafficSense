# Supabase (add all three in Vercel -> Project Settings -> Environment Variables)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (server-only, used for L5 photo verification)
GEMINI_API_KEY=

# Optional local/auth flags (Vercel automatically sets NODE_ENV=production)
AUTH_COOKIE_SECURE=true
DEMO_MODE=false
